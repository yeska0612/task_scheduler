<?xml version="1.0" encoding="utf-8"?>

<!--
    Home дэлгэцийн хэрэглэгчийн интерфэйс.
    Энэ дэлгэц дээр хэрэглэгч одоогийн огноо, мэндчилгээ,
    project жагсаалт, шинэ project үүсгэх карт,
    шинэ task үүсгэх карт болон үргэлжилж байгаа task-уудыг харна.
-->

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F1E8"
    android:fillViewport="true">

    <!-- Бүх элементийг босоо чиглэлээр байрлуулах үндсэн контейнер -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Дээд мөр: menu icon, огноо, profile зураг -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Menu icon -->
            <TextView
                android:id="@+id/tvMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_icon"
                android:textColor="#E76F7A"
                android:textSize="24sp" />

            <!-- Одоогийн огноо -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Tue, Nov 21 2020"
                android:textColor="#555555"
                android:textSize="14sp" />

            <!-- Profile зураг -->
            <androidx.cardview.widget.CardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Profile image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/pro" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Мэндчилгээ -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/hello_user"
            android:textColor="#2F2F2F"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Дэд мэндчилгээ -->
        <TextView
            android:id="@+id/tvSubGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/have_a_nice_day"
            android:textColor="#666666"
            android:textSize="16sp" />

        <!-- Projects хэсгийн гарчиг -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Projects title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/projects"
                android:textColor="#2F2F2F"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Projects see more -->
            <TextView
                android:id="@+id/tvSeeMoreProjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="@string/see_more"
                android:textColor="#666666"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Project жагсаалтыг хэвтээ байдлаар харуулах RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProjects"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="14dp"
            android:overScrollMode="never" />

        <!-- Шинэ project үүсгэх карт -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCreateProject"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <!-- Картын зүүн талын текстүүд -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Project create title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_new_project"
                        android:textColor="#2F2F2F"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Project create subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/create_new_project_subtitle"
                        android:textColor="#777777"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Нэмэх тэмдэгтэй icon -->
                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="#EAB774">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/plus_sign"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </FrameLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Шинэ task үүсгэх карт -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCreateTask"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <!-- Картын зүүн талын текстүүд -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Task create title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_new_task_title"
                        android:textColor="#2F2F2F"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Task create subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/create_new_task_subtitle"
                        android:textColor="#777777"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Нэмэх тэмдэгтэй icon -->
                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="#E76F7A">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/plus_sign"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </FrameLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Calendar руу орох карт -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardOpenCalendar"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <!-- Зүүн талын текстүүд -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_calendar"
                        android:textColor="#2F2F2F"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/open_calendar_subtitle"
                        android:textColor="#777777"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Calendar icon маягийн frame -->
                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="#7E57C2">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/calendar_emoji"
                        android:textColor="@android:color/white"
                        android:textSize="20sp" />
                </FrameLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ongoing Task хэсгийн гарчиг -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Ongoing task title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ongoing_task"
                android:textColor="#2F2F2F"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Tasks see more -->
            <TextView
                android:id="@+id/tvSeeMoreTasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="@string/see_more"
                android:textColor="#666666"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Одоогийн task-уудыг харуулах RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOngoingTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>