<?xml version="1.0" encoding="utf-8"?>

<!--
    Даалгавар үүсгэх / засах дэлгэцийн хэрэглэгчийн интерфэйс.
    Хэрэглэгч энд даалгаврын нэр, тайлбар, project, огноо,
    эхлэх цаг, ангилал, эрэмбэ, сануулагчийг тохируулж хадгална.
-->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F1E8"
    android:fillViewport="true">

    <!-- Бүх элементийг босоо чиглэлээр байрлуулах үндсэн контейнер -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Дээд хэсэг: буцах товч болон гарчиг -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Буцах товч -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#333333" />

            <!-- Дэлгэцийн гарчиг -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/create_new_task"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Баруун талын тэнцвэржүүлэх хоосон зай -->
            <Space
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <!-- Даалгавар үүсгэх дэлгэцийн зураг -->
        <ImageView
            android:id="@+id/imgCreateTaskIllustration"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/task_illustration"
            android:scaleType="fitCenter"
            android:src="@drawable/create_task_calendar" />

        <!-- Даалгаврын нэрийн гарчиг -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/name"
            android:textColor="#E76F7A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Даалгаврын нэр оруулах талбар -->
        <EditText
            android:id="@+id/etTaskName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="name"
            android:background="@android:color/transparent"
            android:hint="@string/task_name_hint"
            android:inputType="textCapSentences"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="#333333"
            android:textColorHint="#888888" />

        <!-- Тусгаарлах зураас -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

        <!-- Даалгаврын тайлбарын гарчиг -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/description"
            android:textColor="#E76F7A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Даалгаврын тайлбар оруулах талбар -->
        <EditText
            android:id="@+id/etTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="none"
            android:background="@android:color/transparent"
            android:hint="@string/task_description_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="#333333"
            android:textColorHint="#888888" />

        <!-- Тусгаарлах зураас -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

        <!-- Аль project-д хамаарахыг сонгох гарчиг -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/project"
            android:textColor="#E76F7A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Project сонгох spinner -->
        <Spinner
            android:id="@+id/spProject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Огноо сонгох гарчиг -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/date"
            android:textColor="#E76F7A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Огноо сонгох хэсэг -->
        <LinearLayout
            android:id="@+id/layoutDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Сонгогдсон огноог харуулах текст -->
            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_date"
                android:textColor="#333333"
                android:textSize="16sp" />

            <!-- Calendar icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/calendar"
                android:src="@android:drawable/ic_menu_my_calendar"
                app:tint="#666666" />
        </LinearLayout>

        <!-- Тусгаарлах зураас -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

        <!-- Эхлэх цагийн гарчиг -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/starting_time"
            android:textColor="#E76F7A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Эхлэх цаг сонгох хэсэг -->
        <LinearLayout
            android:id="@+id/layoutTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Сонгогдсон эхлэх цаг -->
            <TextView
                android:id="@+id/tvSelectedTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_time"
                android:textColor="#333333"
                android:textSize="16sp" />

            <!-- Alarm icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/alarm"
                android:src="@android:drawable/ic_lock_idle_alarm"
                app:tint="#666666" />
        </LinearLayout>

        <!-- Тусгаарлах зураас -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

        <!-- Сануулагч тохируулах хэсэг -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Сануулагчийн зүүн талын icon + text -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Icon background -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#F8BBD0">

                    <!-- Сануулагчийн icon -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/alarm"
                        android:src="@android:drawable/ic_lock_idle_alarm"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <!-- Сануулагчийн текст -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/remind_me"
                    android:textColor="#333333"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Баруун тал руу шахах хоосон зай -->
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Сануулагч асаах/унтраах switch -->
            <Switch
                android:id="@+id/switchReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Reminder options container -->
        <LinearLayout
            android:id="@+id/layoutReminderOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Reminder type label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminder_type"
                android:textColor="#E76F7A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Reminder type spinner -->
            <Spinner
                android:id="@+id/spReminderType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Exact reminder section -->
            <LinearLayout
                android:id="@+id/layoutExactReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvExactReminderValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/select_reminder_datetime"
                    android:textColor="#333333"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/alarm"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="#666666" />
            </LinearLayout>

            <!-- After create reminder section -->
            <LinearLayout
                android:id="@+id/layoutAfterCreateReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remind_after_create"
                    android:textColor="#E76F7A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spAfterCreateDelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Reminder preview -->
            <TextView
                android:id="@+id/tvReminderPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/no_reminder_selected"
                android:textColor="#777777"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Ангилалын хэсгийн гарчиг -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Category title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/category"
                android:textColor="#333333"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- See more text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_more"
                android:textColor="#777777"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Ангилал сонгох товчнууд -->
        <LinearLayout
            android:id="@+id/layoutCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <!-- Life category button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategoryLife"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/category_life"
                android:textAllCaps="false"
                app:cornerRadius="22dp"
                app:strokeColor="#F2C9D7"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- Work category button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategoryWork"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/category_work"
                android:textAllCaps="false"
                app:cornerRadius="22dp"
                app:strokeColor="#E9B8D0"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- Study category button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategoryStudy"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/category_study"
                android:textAllCaps="false"
                app:cornerRadius="22dp"
                app:strokeColor="#EAB774"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Эрэмбийн гарчиг -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/priority"
            android:textColor="#E76F7A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Эрэмбэ сонгох товчнууд -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Low priority -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPriorityLow"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/priority_low"
                android:textAllCaps="false"
                app:cornerRadius="22dp"
                app:strokeColor="#C6E9C6"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- Medium priority -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPriorityMedium"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/priority_medium"
                android:textAllCaps="false"
                app:cornerRadius="22dp"
                app:strokeColor="#F0E098"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- High priority -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPriorityHigh"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/priority_high"
                android:textAllCaps="false"
                app:cornerRadius="22dp"
                app:strokeColor="#F1C3C3"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Даалгавар хадгалах товч -->
        <Button
            android:id="@+id/btnCreateTask"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="28dp"
            android:backgroundTint="#E76F7A"
            android:text="@string/create_task"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>