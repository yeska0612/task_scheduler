<?xml version="1.0" encoding="utf-8"?>

<!--
    Ongoing task item layout.
    Энэ layout нь RecyclerView дээр нэг task-ийг харуулахад ашиглагдана.
    Зүүн талд timeline indicator, баруун талд task-ийн мэдээлэл бүхий card харагдана.
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:orientation="horizontal"
    android:gravity="top">

    <!-- Timeline хэсэг (зүүн тал) -->
    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Timeline-ийн дээд зураас -->
        <View
            android:id="@+id/viewTopLine"
            android:layout_width="2dp"
            android:layout_height="18dp"
            android:background="#F3C9D6" />

        <!-- Task indicator (цэг) -->
        <View
            android:id="@+id/viewTaskIndicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_task_indicator" />

        <!-- Timeline-ийн доод зураас -->
        <View
            android:id="@+id/viewBottomLine"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F3C9D6" />
    </LinearLayout>

    <!-- Task мэдээлэл байрлах card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTask"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#FFFFFF">

        <!-- Card доторх үндсэн контейнер -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Task нэр -->
            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call with Anna Pavlova"
                android:textColor="#E76F7A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Task тайлбар -->
            <TextView
                android:id="@+id/tvTaskDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Task description"
                android:textColor="#777777"
                android:textSize="13sp" />

            <!-- Огноо болон цаг -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Task огноо -->
                <TextView
                    android:id="@+id/tvTaskDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nov 21 2020"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp" />

                <!-- Жижиг тусгаарлах цэг -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_small_dot" />

                <!-- Task цаг -->
                <TextView
                    android:id="@+id/tvTaskTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13:00 - 14:00"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Category болон Priority -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Task category -->
                <TextView
                    android:id="@+id/tvTaskCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Life"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Task priority -->
                <TextView
                    android:id="@+id/tvTaskPriority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="Medium"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>